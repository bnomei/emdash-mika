{
  "compilerOptions": {
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "erasableSyntaxOnly": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@bnomei/emdash-mika": ["./src/index.ts"],
      "@bnomei/emdash-mika/agent": ["./src/agent.ts"],
      "@bnomei/emdash-mika/admin": ["./src/admin.ts"],
      "@bnomei/emdash-mika/astro": ["./src/astro.ts"],
      "@bnomei/emdash-mika/astro-actions": ["./src/astro-actions.ts"],
      "@bnomei/emdash-mika/client": ["./src/api/client.ts"],
      "@bnomei/emdash-mika/email": ["./src/email.ts"],
      "@bnomei/emdash-mika/provider": ["./src/provider.ts"],
      "@bnomei/emdash-mika/react": ["./src/react.ts"],
      "@bnomei/emdash-mika/server": ["./src/server.ts"],
      "@bnomei/emdash-mika/types": ["./src/types/index.ts"]
    },
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "target": "ES2022",
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "vite.config.ts"],
  "exclude": ["dist", "node_modules", "src/templates/**/*.astro"]
}
