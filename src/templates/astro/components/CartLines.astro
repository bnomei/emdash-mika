---
import { actions } from "astro:actions";
import { Button, Text } from "@cloudflare/kumo";
import type { CartDTO } from "@bnomei/emdash-mika/types";
import {
  formatMikaMoney,
  formatMikaVariant,
  mikaMaxPurchaseQuantity,
  mikaReturnTo
} from "@bnomei/emdash-mika/astro";
import { mikaHiddenInput, mikaReturnToInput } from "../lib/form";

interface Props {
  cart?: CartDTO | null;
  returnTo?: string;
  emptyLabel?: string;
  quantityLabel?: string;
  updateLabel?: string;
  removeLabel?: string;
  saveForLaterLabel?: string;
  class?: string;
  [attribute: string]: unknown;
}

const {
  cart,
  returnTo = mikaReturnTo(Astro.url),
  emptyLabel = "Your cart is empty.",
  quantityLabel = "Quantity",
  updateLabel = "Update",
  removeLabel = "Remove",
  saveForLaterLabel = "Save for later",
  class: className,
  ...attrs
} = Astro.props;
const hasEmptySlot = Astro.slots.has("empty");
---

<div {...attrs} data-mika-cart-lines class:list={["mika-kumo-stack", className]}>
  {cart?.items.length ? (
    <ul class="mika-kumo-list">
      {cart.items.map((line) => (
        <li class="mika-kumo-line-item" data-mika-cart-line={line.id}>
          <div>
            <strong>{line.title}</strong>
            {line.variantOptions.length > 0 && (
              <small class="mika-kumo-muted">{formatMikaVariant(line.variantOptions)}</small>
            )}
          </div>

          <form class="mika-kumo-form" action={actions.mika.cart.update} method="post">
            <input type="hidden" {...mikaHiddenInput("lineId", line.id)} />
            <input type="hidden" {...mikaReturnToInput(returnTo)} />
            <label class="mika-kumo-field">
              <span>{quantityLabel}</span>
              <input
                class="mika-kumo-input"
                name="quantity"
                type="number"
                min="1"
                max={mikaMaxPurchaseQuantity(line.availability)}
                inputmode="numeric"
                value={String(line.quantity)}
                aria-label={`${quantityLabel} for ${line.title}`}
              />
            </label>
            <Button
              type="submit"
              variant="secondary"
              aria-label={`${updateLabel} ${line.title}`}
            >
              {updateLabel}
            </Button>
          </form>

          <form class="mika-kumo-form" action={actions.mika.cart.remove} method="post">
            <input type="hidden" {...mikaHiddenInput("lineId", line.id)} />
            <input type="hidden" {...mikaReturnToInput(returnTo)} />
            <Button
              type="submit"
              variant="secondary"
              aria-label={`${removeLabel} ${line.title}`}
            >
              {removeLabel}
            </Button>
          </form>

          <form class="mika-kumo-form" action={actions.mika.wishlist.saveForLater} method="post">
            <input type="hidden" {...mikaHiddenInput("lineId", line.id)} />
            <input type="hidden" {...mikaReturnToInput(returnTo)} />
            <Button
              type="submit"
              variant="secondary"
              aria-label={`${saveForLaterLabel} ${line.title}`}
            >
              {saveForLaterLabel}
            </Button>
          </form>

          <output class="mika-kumo-strong">{formatMikaMoney(line.total)}</output>
        </li>
      ))}
    </ul>
  ) : hasEmptySlot ? (
    <slot name="empty" />
  ) : (
    <Text as="p" variant="secondary">{emptyLabel}</Text>
  )}
</div>
