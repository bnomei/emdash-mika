---
import { Link, Text } from "@cloudflare/kumo";
import type { DownloadDTO } from "@bnomei/emdash-mika/types";

interface Props {
  downloads: readonly DownloadDTO[];
  headingLabel?: string;
  emptyLabel?: string;
  class?: string;
  [attribute: string]: unknown;
}

const {
  downloads,
  headingLabel = "Downloads",
  emptyLabel = "No downloads.",
  class: className,
  ...attrs
} = Astro.props;
const hasEmptySlot = Astro.slots.has("empty");
---

<section {...attrs} data-mika-account-downloads class:list={["mika-kumo-stack", className]}>
  <Text as="h2" variant="heading2"><slot name="heading">{headingLabel}</slot></Text>
  {downloads.length ? (
    <ul class="mika-kumo-list">
      {downloads.map((download) => (
        <li class="mika-kumo-line-item">
          <Link href={download.href}>{download.title}</Link>
          {download.expiresAt && (
            <time class="mika-kumo-muted" datetime={download.expiresAt}>
              {new Date(download.expiresAt).toLocaleDateString()}
            </time>
          )}
        </li>
      ))}
    </ul>
  ) : hasEmptySlot ? (
    <slot name="empty" />
  ) : (
    <Text as="p" variant="secondary">{emptyLabel}</Text>
  )}
</section>
