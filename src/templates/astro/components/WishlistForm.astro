---
// mika-template-version: 0.0.0
import { actions } from "astro:actions";
import { Button } from "@cloudflare/kumo";
import { mikaHiddenInput, mikaReturnTo, mikaReturnToInput } from "@bnomei/emdash-mika/astro";

interface Props {
  sellableId: string;
  priceId?: string;
  returnTo?: string;
  label?: string;
  disabled?: boolean;
  buttonClass?: string;
  class?: string;
  [attribute: string]: unknown;
}

const {
  sellableId,
  priceId,
  returnTo = mikaReturnTo(Astro.url),
  label = "Save to wishlist",
  disabled = false,
  buttonClass,
  class: className,
  ...attrs
} = Astro.props;
---

<form
  {...attrs}
  data-mika-wishlist
  class:list={["mika-kumo-form", className]}
  action={actions.mika.wishlist.add}
  method="post"
>
  <input
    type="hidden"
    {...mikaHiddenInput("sellableId", sellableId)}
    data-mika-selected-sellable-id
  />
  <input
    type="hidden"
    {...mikaHiddenInput("priceId", priceId)}
    data-mika-selected-price-id
  />
  <input type="hidden" {...mikaReturnToInput(returnTo)} />
  <Button
    type="submit"
    className={buttonClass}
    variant="secondary"
    disabled={disabled}
    data-mika-purchase-submit
    data-mika-initial-disabled={disabled ? "true" : "false"}
  >
    <slot>{label}</slot>
  </Button>
</form>
