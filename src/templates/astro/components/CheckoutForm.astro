---
import { actions } from "astro:actions";
import { Button } from "@cloudflare/kumo";
import type { CartDTO } from "@bnomei/emdash-mika/types";
import { mikaReturnTo } from "@bnomei/emdash-mika/astro";
import { mikaHiddenInput, mikaRedirectInputs } from "../lib/form";
import { mikaTemplateRoutes } from "../lib/routes";

interface Props {
  cart?: CartDTO | null;
  successPath?: string;
  cancelPath?: string;
  returnTo?: string;
  email?: string;
  name?: string;
  company?: string;
  vatId?: string;
  emailLabel?: string;
  nameLabel?: string;
  companyLabel?: string;
  vatIdLabel?: string;
  customerLegend?: string;
  showCustomerFields?: boolean;
  label?: string;
  class?: string;
  [attribute: string]: unknown;
}

const {
  cart,
  successPath = mikaTemplateRoutes.checkoutSuccess,
  cancelPath = mikaTemplateRoutes.checkoutCancel,
  returnTo = mikaReturnTo(Astro.url),
  email,
  name,
  company,
  vatId,
  emailLabel = "Email",
  nameLabel = "Name",
  companyLabel = "Company",
  vatIdLabel = "VAT ID",
  customerLegend = "Customer details",
  showCustomerFields = true,
  label = "Checkout",
  class: className,
  ...attrs
} = Astro.props;
const disabled = !cart || cart.items.length === 0;
const redirectInputs = mikaRedirectInputs({ successPath, cancelPath, returnTo });
---

<form
  {...attrs}
  data-mika-checkout
  class:list={["mika-kumo-form", className]}
  action={actions.mika.checkout.start}
  method="post"
>
  {cart?.id && <input type="hidden" {...mikaHiddenInput("cartId", cart.id)} />}
  <input type="hidden" {...redirectInputs.successPath} />
  <input type="hidden" {...redirectInputs.cancelPath} />
  <input type="hidden" {...redirectInputs.returnTo} />

  {showCustomerFields && (
    <fieldset data-mika-checkout-customer class="mika-kumo-fieldset">
      <legend class="mika-kumo-legend">{customerLegend}</legend>
      <label class="mika-kumo-field">
        <span>{emailLabel}</span>
        <input
          class="mika-kumo-input"
          name="email"
          type="email"
          autocomplete="email"
          value={email}
        />
      </label>
      <label class="mika-kumo-field">
        <span>{nameLabel}</span>
        <input class="mika-kumo-input" name="name" autocomplete="name" value={name} />
      </label>
      <label class="mika-kumo-field">
        <span>{companyLabel}</span>
        <input
          class="mika-kumo-input"
          name="company"
          autocomplete="organization"
          value={company}
        />
      </label>
      <label class="mika-kumo-field">
        <span>{vatIdLabel}</span>
        <input class="mika-kumo-input" name="vatId" value={vatId} />
      </label>
    </fieldset>
  )}

  <Button type="submit" variant="primary" disabled={disabled}>{label}</Button>
</form>
