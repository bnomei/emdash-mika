---
import { actions } from "astro:actions";
import { Badge, Button, Text } from "@cloudflare/kumo";
import type { SubscriptionDTO } from "@bnomei/emdash-mika/types";
import { mikaReturnTo } from "@bnomei/emdash-mika/astro";
import { mikaReturnToInput } from "../lib/form";

interface Props {
  subscriptions: readonly SubscriptionDTO[];
  returnTo?: string;
  error?: string;
  headingLabel?: string;
  emptyLabel?: string;
  cancelLabel?: string;
  renewLabel?: string;
  changeLabel?: string;
  showChangeAction?: boolean;
  changePriceIds?: Readonly<Record<string, string>>;
  class?: string;
  [attribute: string]: unknown;
}

const {
  subscriptions,
  returnTo = mikaReturnTo(Astro.url),
  error,
  headingLabel = "Subscriptions",
  emptyLabel = "No subscriptions.",
  cancelLabel = "Cancel",
  renewLabel = "Renew",
  changeLabel = "Change",
  showChangeAction = false,
  changePriceIds = {},
  class: className,
  ...attrs
} = Astro.props;
const hasEmptySlot = Astro.slots.has("empty");
---

<section {...attrs} data-mika-account-subscriptions class:list={["mika-kumo-stack", className]}>
  <Text as="h2" variant="heading2"><slot name="heading">{headingLabel}</slot></Text>
  {error && <Text as="p" variant="error" role="alert">{error}</Text>}
  {subscriptions.length ? (
    <ul class="mika-kumo-list">
      {subscriptions.map((subscription) => (
        <li class="mika-kumo-line-item">
          <strong>{subscription.title}</strong>
          <Badge variant={subscription.status === "active" ? "success" : "secondary"}>
            {subscription.status}
          </Badge>
          {subscription.currentPeriodEnd && (
            <time class="mika-kumo-muted" datetime={subscription.currentPeriodEnd}>
              {new Date(subscription.currentPeriodEnd).toLocaleDateString()}
            </time>
          )}
          {subscription.providerActions?.includes("cancel") && (
            <form class="mika-kumo-form" action={actions.mika.subscription.cancel} method="post">
              <input
                type="hidden"
                name="subscriptionId"
                value={subscription.id}
              />
              <input type="hidden" {...mikaReturnToInput(returnTo)} />
              <Button
                type="submit"
                variant="secondary"
                aria-label={`${cancelLabel} ${subscription.title}`}
              >
                {cancelLabel}
              </Button>
            </form>
          )}
          {subscription.providerActions?.includes("renew") && (
            <form class="mika-kumo-form" action={actions.mika.subscription.renew} method="post">
              <input
                type="hidden"
                name="subscriptionId"
                value={subscription.id}
              />
              <input type="hidden" {...mikaReturnToInput(returnTo)} />
              <Button
                type="submit"
                variant="secondary"
                aria-label={`${renewLabel} ${subscription.title}`}
              >
                {renewLabel}
              </Button>
            </form>
          )}
          {showChangeAction && subscription.providerActions?.includes("change") && changePriceIds[subscription.id] && (
            <form class="mika-kumo-form" action={actions.mika.subscription.change} method="post">
              <input
                type="hidden"
                name="subscriptionId"
                value={subscription.id}
              />
              <input
                type="hidden"
                name="priceId"
                value={changePriceIds[subscription.id] ?? ""}
              />
              <input type="hidden" {...mikaReturnToInput(returnTo)} />
              <Button
                type="submit"
                variant="secondary"
                aria-label={`${changeLabel} ${subscription.title}`}
              >
                {changeLabel}
              </Button>
            </form>
          )}
        </li>
      ))}
    </ul>
  ) : hasEmptySlot ? (
    <slot name="empty" />
  ) : (
    <Text as="p" variant="secondary">{emptyLabel}</Text>
  )}
</section>
