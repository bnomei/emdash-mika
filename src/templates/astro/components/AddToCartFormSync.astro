<!-- mika-template-version: 0.0.0 -->
<script>
  interface MikaVariantChangeDetail {
    readonly sellableId?: string;
    readonly priceId?: string;
    readonly maxQuantity?: number;
  }

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-mika-add-to-cart]")) {
    const groups = form.querySelector<HTMLFieldSetElement>("[data-mika-variant-groups]");
    if (!groups) continue;

    const sync = (detail: MikaVariantChangeDetail = {}) => {
      const sellableId =
        detail.sellableId ?? groups.dataset.mikaSelectedSellableId ?? "";
      const maxQuantity =
        detail.maxQuantity === undefined
          ? groups.dataset.mikaSelectedMaxQuantity ?? ""
          : String(detail.maxQuantity);

      for (const button of form.querySelectorAll<HTMLButtonElement>("[data-mika-purchase-submit]")) {
        button.disabled =
          sellableId === "" || button.dataset.mikaInitialDisabled === "true";
        if (button.dataset.mikaEnabledLabel && button.dataset.mikaDisabledLabel) {
          button.textContent = button.disabled
            ? button.dataset.mikaDisabledLabel
            : button.dataset.mikaEnabledLabel;
        }
      }

      for (const input of form.querySelectorAll<HTMLInputElement>("[data-mika-purchase-quantity]")) {
        input.disabled =
          sellableId === "" || input.dataset.mikaInitialDisabled === "true";
        if (maxQuantity === "") {
          input.removeAttribute("max");
        } else {
          input.setAttribute("max", maxQuantity);
          if (Number(input.value) > Number(maxQuantity)) input.value = maxQuantity;
        }
      }

      for (const panel of form.querySelectorAll<HTMLElement>("[data-mika-availability-for]")) {
        panel.hidden = panel.dataset.mikaAvailabilityFor !== sellableId;
      }
    };

    groups.addEventListener("mika:variant-change", (event) =>
      sync((event as CustomEvent<MikaVariantChangeDetail>).detail)
    );
    sync();
  }
</script>
