---
// mika-template-version: 0.1.1
import { actions } from "astro:actions";
import { Badge, Button, Empty, Table, Text } from "@cloudflare/kumo";
import type { WishlistDTO } from "@bnomei/emdash-mika/types";
import { mikaHiddenInput, mikaReturnTo, mikaReturnToInput } from "@bnomei/emdash-mika/astro";
import { mikaTemplatePlural } from "../lib/display";

interface Props {
  wishlist?: WishlistDTO | null;
  returnTo?: string;
  headingLabel?: string;
  emptyLabel?: string;
  emptyDescription?: string;
  removeLabel?: string;
  moveToCartLabel?: string;
  itemLabel?: string;
  actionsLabel?: string;
  class?: string;
  [attribute: string]: unknown;
}

const {
  wishlist,
  returnTo = mikaReturnTo(Astro.url),
  headingLabel = "Wishlist",
  emptyLabel = "No saved items",
  emptyDescription = "Save products here to compare or buy later.",
  removeLabel = "Remove from wishlist",
  moveToCartLabel = "Move to cart",
  itemLabel = "Item",
  actionsLabel = "Actions",
  class: className,
  ...attrs
} = Astro.props;
const hasEmptySlot = Astro.slots.has("empty");
const savedCount = wishlist?.items.length ?? 0;
---

<section {...attrs} data-mika-wishlist-list class:list={["mika-kumo-stack", className]}>
  <div class="mika-kumo-title-row">
    <Text as="h2" variant="heading2"><slot name="heading">{headingLabel}</slot></Text>
    <Badge variant="secondary">{mikaTemplatePlural(savedCount, "saved item")}</Badge>
  </div>
  {wishlist?.items.length ? (
    <div class="mika-kumo-table-scroll">
      <Table>
        <Table.Header>
          <Table.Row>
            <Table.Head>{itemLabel}</Table.Head>
            <Table.Head>{actionsLabel}</Table.Head>
          </Table.Row>
        </Table.Header>
        <Table.Body>
          {wishlist.items.map((item) => (
            <Table.Row>
              <Table.Cell><strong>{item.title}</strong></Table.Cell>
              <Table.Cell>
                <div class="mika-kumo-actions">
                  <form class="mika-kumo-form" action={actions.mika.wishlist.moveToCart.queryString} method="post">
                    <input type="hidden" {...mikaHiddenInput("itemId", item.id)} />
                    <input type="hidden" {...mikaReturnToInput(returnTo)} />
                    <Button type="submit" variant="secondary" aria-label={`${moveToCartLabel} ${item.title}`}>
                      {moveToCartLabel}
                    </Button>
                  </form>
                  <form class="mika-kumo-form" action={actions.mika.wishlist.remove.queryString} method="post">
                    <input type="hidden" {...mikaHiddenInput("itemId", item.id)} />
                    <input type="hidden" {...mikaReturnToInput(returnTo)} />
                    <Button type="submit" variant="secondary-destructive" aria-label={`${removeLabel} ${item.title}`}>
                      {removeLabel}
                    </Button>
                  </form>
                </div>
              </Table.Cell>
            </Table.Row>
          ))}
        </Table.Body>
      </Table>
    </div>
  ) : hasEmptySlot ? (
    <slot name="empty" />
  ) : (
    <Empty size="sm" title={emptyLabel} description={emptyDescription} />
  )}
</section>
