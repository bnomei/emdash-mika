---
import { actions } from "astro:actions";
import { Button, Text } from "@cloudflare/kumo";
import type { WishlistDTO } from "@bnomei/emdash-mika/types";
import { mikaReturnTo } from "@bnomei/emdash-mika/astro";
import { mikaHiddenInput, mikaReturnToInput } from "../lib/form";

interface Props {
  wishlist?: WishlistDTO | null;
  returnTo?: string;
  headingLabel?: string;
  emptyLabel?: string;
  removeLabel?: string;
  moveToCartLabel?: string;
  class?: string;
  [attribute: string]: unknown;
}

const {
  wishlist,
  returnTo = mikaReturnTo(Astro.url),
  headingLabel = "Wishlist",
  emptyLabel = "No saved items.",
  removeLabel = "Remove",
  moveToCartLabel = "Move to cart",
  class: className,
  ...attrs
} = Astro.props;
const hasEmptySlot = Astro.slots.has("empty");
---

<section {...attrs} data-mika-wishlist-list class:list={["mika-kumo-stack", className]}>
  <Text as="h2" variant="heading2"><slot name="heading">{headingLabel}</slot></Text>
  {wishlist?.items.length ? (
    <ul class="mika-kumo-list">
      {wishlist.items.map((item) => (
        <li class="mika-kumo-line-item">
          <span>{item.title}</span>
          <form class="mika-kumo-form" action={actions.mika.wishlist.remove} method="post">
            <input type="hidden" {...mikaHiddenInput("itemId", item.id)} />
            <input type="hidden" {...mikaReturnToInput(returnTo)} />
            <Button
              type="submit"
              variant="secondary"
              aria-label={`${removeLabel} ${item.title}`}
            >
              {removeLabel}
            </Button>
          </form>
          <form class="mika-kumo-form" action={actions.mika.wishlist.moveToCart} method="post">
            <input type="hidden" {...mikaHiddenInput("itemId", item.id)} />
            <input type="hidden" {...mikaReturnToInput(returnTo)} />
            <Button
              type="submit"
              variant="secondary"
              aria-label={`${moveToCartLabel} ${item.title}`}
            >
              {moveToCartLabel}
            </Button>
          </form>
        </li>
      ))}
    </ul>
  ) : hasEmptySlot ? (
    <slot name="empty" />
  ) : (
    <Text as="p" variant="secondary">{emptyLabel}</Text>
  )}
</section>
