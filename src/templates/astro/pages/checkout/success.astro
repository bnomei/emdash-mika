---
import { Link, Text } from "@cloudflare/kumo";
import { createMika } from "@bnomei/emdash-mika/astro";
import MikaKumoPage from "../../components/MikaKumoPage.astro";
import { mikaTemplateCurrentCartItemCount } from "../../lib/cart";
import {
  mikaTemplateCheckoutSuccessHref,
  mikaTemplateRoutes
} from "../../lib/routes";

export const prerender = false;

const checkoutId =
  Astro.url.searchParams.get("checkoutId") ??
  Astro.url.searchParams.get("checkout_id") ??
  Astro.url.searchParams.get("session_id");
const Mika = createMika(Astro);
const result = checkoutId ? await Mika.checkout.status(checkoutId) : null;
const checkout = result?.ok ? result.data : null;
const status = checkout?.status ?? "pending";
const messageByStatus: Record<string, string> = {
  pending: "Payment pending.",
  completed: "Order complete.",
  cancelled: "Checkout cancelled.",
  expired: "Checkout expired.",
  failed: "Checkout failed.",
  binding_mismatch: "Checkout could not be verified."
};
const cartItemCount = await mikaTemplateCurrentCartItemCount(Astro);
---

<MikaKumoPage title="Checkout" pageSize="narrow" cartItemCount={cartItemCount} data-mika-checkout-success>
  <section class="mika-kumo-panel mika-kumo-stack">
    <Text as="p" aria-live="polite">{messageByStatus[status] ?? "Checkout received."}</Text>
    <div class="mika-kumo-actions">
      {status === "pending" && checkoutId && (
        <Link href={mikaTemplateCheckoutSuccessHref(checkoutId)}>Refresh status</Link>
      )}
      {checkout?.orderId && <Link href={mikaTemplateRoutes.accountOrders}>View orders</Link>}
    </div>
  </section>
</MikaKumoPage>
