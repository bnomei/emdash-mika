---
import { Link, Text } from "@cloudflare/kumo";
import MikaKumoPage from "../../components/MikaKumoPage.astro";
import { mikaTemplateRoutes } from "../../lib/routes";

export const prerender = false;

const cartHref = mikaTemplateRoutes.cart;
---

<MikaKumoPage title="Checkout cancelled" pageSize="narrow" data-mika-checkout-cancel>
  <section class="mika-kumo-panel mika-kumo-stack">
    <Text as="p" variant="secondary">No payment was completed.</Text>
    <Link href={cartHref}>Return to cart</Link>
  </section>
</MikaKumoPage>
