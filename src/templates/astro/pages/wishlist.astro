---
import { actions } from "astro:actions";
import { Link, Text } from "@cloudflare/kumo";
import { createMika } from "@bnomei/emdash-mika/astro";
import MikaKumoPage from "../components/MikaKumoPage.astro";
import WishlistList from "../components/WishlistList.astro";
import { mikaTemplateRoutes } from "../lib/routes";

export const prerender = false;

const Mika = createMika(Astro);

const removeResult = Astro.getActionResult(actions.mika.wishlist.remove);
const moveToCartResult = Astro.getActionResult(actions.mika.wishlist.moveToCart);
const actionError = removeResult?.error?.message ?? moveToCartResult?.error?.message;
const wishlistResult = await Mika.wishlist.get();
const wishlist = wishlistResult.ok ? wishlistResult.data : null;
const error = actionError ?? (wishlistResult.ok ? null : wishlistResult.error.message);
---

<MikaKumoPage title="Wishlist" pageSize="narrow" data-mika-wishlist-page>
  <section class="mika-kumo-panel mika-kumo-stack">
    {error && <Text as="p" variant="error" role="alert">{error}</Text>}
    {moveToCartResult?.data && (
      <Text as="p" variant="success" role="status">Item moved to cart.</Text>
    )}
    <WishlistList wishlist={wishlist} />
    {!(wishlist?.items.length) && (
      <div class="mika-kumo-actions">
        <Link href={mikaTemplateRoutes.products}>Browse products</Link>
      </div>
    )}
  </section>
</MikaKumoPage>
