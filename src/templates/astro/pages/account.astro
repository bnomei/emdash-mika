---
// mika-template-version: 0.0.0
import { actions, isInputError } from "astro:actions";
import { Button, Text } from "@cloudflare/kumo";
import { createMika, mikaReturnToInput } from "@bnomei/emdash-mika/astro";
import { api } from "../lib/mika-api";
import AccountSignInPanel from "../components/AccountSignInPanel.astro";
import MikaKumoPage from "../components/MikaKumoPage.astro";
import { mikaTemplateCurrentCartItemCount } from "../lib/cart";
import { mikaTemplateStatusLabel } from "../lib/display";
import { mikaTemplateRoutes } from "../lib/routes";

export const prerender = false;

const Mika = createMika(Astro, { api });

const portalResult = Astro.getActionResult(actions.mika.account.portal);
if (portalResult?.data?.redirectUrl) {
  return Astro.redirect(portalResult.data.redirectUrl);
}

const magicLinkResult = Astro.getActionResult(actions.mika.magicLink.request);
const exportResult = Astro.getActionResult(actions.mika.account["export"]);
const deleteResult = Astro.getActionResult(actions.mika.account["delete"]);
const magicLinkInputErrors = isInputError(magicLinkResult?.error)
  ? magicLinkResult.error.fields
  : {};
const magicLinkError = isInputError(magicLinkResult?.error)
  ? null
  : magicLinkResult?.error?.message;
const accountActionError = portalResult?.error?.message;
const accountExportError = exportResult?.error?.message;
const accountDeleteError = deleteResult?.error?.message;
const accountResult = await Mika.account.get();
const account = accountResult.ok ? accountResult.data : null;
const accountLoadError =
  !accountResult.ok && accountResult.error.code !== "AUTH_REQUIRED"
    ? accountResult.error.message
    : null;
const cartItemCount = await mikaTemplateCurrentCartItemCount(Astro);
---

<MikaKumoPage title="Account" pageSize="narrow" cartItemCount={cartItemCount} data-mika-account-page>
  {!account && (
    <AccountSignInPanel
      returnTo={mikaTemplateRoutes.account}
      accountLoadError={accountLoadError}
      magicLinkSent={magicLinkResult?.data?.sent}
      magicLinkError={magicLinkError}
      emailError={magicLinkInputErrors.email?.join(", ")}
    />
  )}

  {account && (
    <section class="mika-kumo-panel mika-kumo-stack">
      <Text as="h2" variant="heading2">Profile</Text>
      {account.customer?.email && <Text as="p" variant="secondary">{account.customer.email}</Text>}
      {(accountActionError || accountLoadError) && (
        <Text as="p" variant="error" role="alert">{accountActionError ?? accountLoadError}</Text>
      )}
      {accountExportError && <Text as="p" variant="error" role="alert">{accountExportError}</Text>}
      {accountDeleteError && <Text as="p" variant="error" role="alert">{accountDeleteError}</Text>}
      {exportResult?.data?.status && (
        <Text as="p" variant="success" role="status">
          Export {mikaTemplateStatusLabel(exportResult.data.status)}.
        </Text>
      )}
      {deleteResult?.data?.requested && (
        <Text as="p" variant="success" role="status">Account deletion requested.</Text>
      )}

      <div class="mika-kumo-actions">
      <form class="mika-kumo-form" action={actions.mika.account.portal.queryString} method="post">
        <input type="hidden" {...mikaReturnToInput(mikaTemplateRoutes.account)} />
        <Button type="submit" variant="secondary">Manage billing in portal</Button>
      </form>
      <form class="mika-kumo-form" action={actions.mika.account["export"].queryString} method="post">
        <input type="hidden" {...mikaReturnToInput(mikaTemplateRoutes.account)} />
        <Button type="submit" variant="secondary">Export account data</Button>
      </form>
      <form class="mika-kumo-form" action={actions.mika.account["delete"].queryString} method="post">
        <input type="hidden" {...mikaReturnToInput(mikaTemplateRoutes.account)} />
        <Button type="submit" variant="secondary-destructive">Delete account</Button>
      </form>
      </div>
    </section>
  )}
</MikaKumoPage>
