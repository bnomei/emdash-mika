---
import { actions, isInputError } from "astro:actions";
import { createMika } from "@bnomei/emdash-mika/astro";
import AccountDownloads from "../components/AccountDownloads.astro";
import AccountOrders from "../components/AccountOrders.astro";
import AccountSubscriptions from "../components/AccountSubscriptions.astro";
import MagicLinkForm from "../components/MagicLinkForm.astro";
import { mikaReturnToInput } from "../lib/form";
import { mikaTemplateRoutes } from "../lib/routes";

export const prerender = false;

const Mika = createMika(Astro);

const portalResult = Astro.getActionResult(actions.mika.account.portal);
if (portalResult?.data?.redirectUrl) {
  return Astro.redirect(portalResult.data.redirectUrl);
}

const magicLinkResult = Astro.getActionResult(actions.mika.magicLink.request);
const exportResult = Astro.getActionResult(actions.mika.account.export);
const deleteResult = Astro.getActionResult(actions.mika.account.delete);
const cancelResult = Astro.getActionResult(actions.mika.subscription.cancel);
const renewResult = Astro.getActionResult(actions.mika.subscription.renew);
const changeResult = Astro.getActionResult(actions.mika.subscription.change);
const magicLinkInputErrors = isInputError(magicLinkResult?.error)
  ? magicLinkResult.error.fields
  : {};
const magicLinkError = isInputError(magicLinkResult?.error)
  ? null
  : magicLinkResult?.error?.message;
const subscriptionError =
  cancelResult?.error?.message ??
  renewResult?.error?.message ??
  changeResult?.error?.message;
const accountActionError = portalResult?.error?.message;
const accountExportError = exportResult?.error?.message;
const accountDeleteError = deleteResult?.error?.message;
const accountResult = await Mika.account.get();
const account = accountResult.ok ? accountResult.data : null;
const accountLoadError =
  !accountResult.ok && accountResult.error.code !== "AUTH_REQUIRED"
    ? accountResult.error.message
    : null;
---

<main data-mika-account-page>
  <h1>Account</h1>

  {!account && (
    <section>
      <h2>Sign in</h2>
      {accountLoadError && <p role="alert">{accountLoadError}</p>}
      {magicLinkResult?.data?.sent && <p role="status">Email sent.</p>}
      {magicLinkError && <p role="alert">{magicLinkError}</p>}
      <MagicLinkForm
        id="mika-account-magic-link"
        returnTo={mikaTemplateRoutes.account}
        emailError={magicLinkInputErrors.email?.join(", ")}
      />
    </section>
  )}

  {account && (
    <>
      {account.customer?.email && <p>{account.customer.email}</p>}
      {(accountActionError || accountLoadError) && (
        <p role="alert">{accountActionError ?? accountLoadError}</p>
      )}
      {accountExportError && <p role="alert">{accountExportError}</p>}
      {accountDeleteError && <p role="alert">{accountDeleteError}</p>}
      {exportResult?.data?.status && (
        <p role="status">Export {exportResult.data.status}.</p>
      )}
      {deleteResult?.data?.requested && (
        <p role="status">Account deletion requested.</p>
      )}
      <AccountOrders orders={account.orders} />
      <AccountSubscriptions
        subscriptions={account.subscriptions}
        error={subscriptionError}
      />
      <AccountDownloads downloads={account.downloads} />

      <form action={actions.mika.account.portal} method="post">
        <input type="hidden" {...mikaReturnToInput(mikaTemplateRoutes.account)} />
        <button type="submit">Billing portal</button>
      </form>
      <form action={actions.mika.account.export} method="post">
        <input type="hidden" {...mikaReturnToInput(mikaTemplateRoutes.account)} />
        <button type="submit">Export account data</button>
      </form>
      <form action={actions.mika.account.delete} method="post">
        <input type="hidden" {...mikaReturnToInput(mikaTemplateRoutes.account)} />
        <button type="submit">Delete account</button>
      </form>
    </>
  )}
</main>
